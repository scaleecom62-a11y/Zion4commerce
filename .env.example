# ============================================================
# Zion4Commerce — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ── Sanity CMS ────────────────────────────────────────────
# Get these from https://www.sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Sanity API token (read + write — server-side only, never expose to client)
# Create at sanity.io/manage → API → Tokens → Add API token
SANITY_API_TOKEN=your_sanity_api_token_here

# Sanity webhook secret (set same value in Sanity dashboard webhook settings)
SANITY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Site ─────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://zion4commerce.com

# ── Email (Resend) ────────────────────────────────────────
# Get from https://resend.com → API Keys
# Used to send contact form submissions
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@zion4commerce.com
RESEND_TO_EMAIL=zion4commerce@gmail.com

# ── Analytics (optional) ─────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
